--- a/src/rlinfSelection.tsx
+++ b/src/rlinfSelection.tsx
@@ -0,0 +1,119 @@
+/** RLinf editor additions: an outline around the selected scene nodes that stays visible behind other
+ * objects. The editor page names the nodes with `window.__rlinfOutline(names)` (a node and everything
+ * under it); each mesh draws its footprint into the stencil buffer, then a screen-space shell around it
+ * where the footprint is not, both without depth testing. */
+import React from "react";
+import * as THREE from "three";
+import { useThree } from "@react-three/fiber";
+import { OutlinesMaterial } from "./OutlinesMaterial";
+
+let outlined: string[] = [];
+const listeners = new Set<() => void>();
+
+function isOutlined(name: string): boolean {
+  return outlined.some((p) => name === p || name.startsWith(p + "/"));
+}
+
+function subscribe(listener: () => void) {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+}
+
+(window as any).__rlinfOutline = (names: string[]) => {
+  if (names.length === outlined.length && names.every((n, i) => n === outlined[i])) return;
+  outlined = names.slice();
+  listeners.forEach((listener) => listener());
+};
+
+/** Name of the scene node a mesh belongs to (provided by SceneTree). */
+export const NodeNameContext = React.createContext<string>("");
+
+function useOutlined(): boolean {
+  const name = React.useContext(NodeNameContext);
+  return React.useSyncExternalStore(subscribe, () => name !== "" && isOutlined(name));
+}
+
+const MASK_ORDER = 10000;
+const OUTLINE_COLOR = 0xff9a1f;
+const OUTLINE_PIXELS = 3;
+
+const maskMaterial = new THREE.MeshBasicMaterial({
+  colorWrite: false,
+  depthWrite: false,
+  depthTest: false,
+  transparent: true,
+  side: THREE.DoubleSide,
+  stencilWrite: true,
+  stencilRef: 1,
+  stencilFunc: THREE.AlwaysStencilFunc,
+  stencilZPass: THREE.ReplaceStencilOp,
+  stencilZFail: THREE.ReplaceStencilOp,
+  stencilFail: THREE.ReplaceStencilOp,
+});
+
+function useShellMaterial() {
+  const gl = useThree((state) => state.gl);
+  const material = React.useMemo(() => {
+    const m = new OutlinesMaterial({ side: THREE.BackSide }) as any;
+    m.thickness = OUTLINE_PIXELS * gl.getPixelRatio();
+    m.color = new THREE.Color(OUTLINE_COLOR);
+    m.opacity = 1;
+    m.size = gl.getDrawingBufferSize(new THREE.Vector2());
+    m.screenspace = true;
+    m.transparent = true;
+    m.toneMapped = false;
+    m.depthTest = false;
+    m.depthWrite = false;
+    m.stencilWrite = true;
+    m.stencilRef = 1;
+    m.stencilFunc = THREE.NotEqualStencilFunc;
+    m.stencilFail = THREE.KeepStencilOp;
+    m.stencilZFail = THREE.KeepStencilOp;
+    m.stencilZPass = THREE.KeepStencilOp;
+    return m as THREE.Material;
+  }, [gl]);
+  React.useEffect(() => () => material.dispose(), [material]);
+  return material;
+}
+
+function Shells(props: { geometry: THREE.BufferGeometry; matrix?: THREE.Matrix4 }) {
+  const shell = useShellMaterial();
+  const placed = props.matrix ? { matrix: props.matrix, matrixAutoUpdate: false } : {};
+  return (
+    <>
+      <mesh geometry={props.geometry} material={maskMaterial} renderOrder={MASK_ORDER} {...placed} />
+      <mesh geometry={props.geometry} material={shell} renderOrder={MASK_ORDER + 1} {...placed} />
+    </>
+  );
+}
+
+/** Child of a mesh: outlines the parent's geometry while its node is selected. */
+export function SelectionOutline() {
+  const on = useOutlined();
+  const ref = React.useRef<THREE.Group>(null);
+  const [geometry, setGeometry] = React.useState<THREE.BufferGeometry | null>(null);
+  React.useLayoutEffect(() => {
+    const parent = ref.current?.parent as THREE.Mesh | undefined;
+    if (parent?.geometry && parent.geometry !== geometry) setGeometry(parent.geometry);
+  });
+  return <group ref={ref}>{on && geometry ? <Shells geometry={geometry} /> : null}</group>;
+}
+
+/** The meshes of a GLB (with their matrices inside it): outlined while its node is selected. */
+export function SelectionOutlineGroup(props: {
+  meshes: THREE.Mesh[];
+  matrices: THREE.Matrix4[];
+  scale: any;
+}) {
+  const on = useOutlined();
+  if (!on) return null;
+  return (
+    <group scale={props.scale}>
+      {props.meshes.map((mesh, i) => (
+        <Shells key={i} geometry={mesh.geometry} matrix={props.matrices[i]} />
+      ))}
+    </group>
+  );
+}
