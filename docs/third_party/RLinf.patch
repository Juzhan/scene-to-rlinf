+def adaptive_kl_learning_rate(
+    learning_rate: float,
+    kl_mean: float,
+    target: float,
+    minimum: float = 1e-5,
+    maximum: float = 1e-2,
+) -> float:
+    """Apply the RSL-RL learning-rate rule to one complete minibatch KL."""
+    if not all(math.isfinite(value) for value in (learning_rate, kl_mean, target)):
+        raise ValueError("Adaptive KL requires finite learning rate, KL, and target")
+    if target <= 0 or not 0 < minimum <= learning_rate <= maximum:
+        raise ValueError("Adaptive KL requires a positive target and bounded learning rate")
+    if kl_mean > 2 * target:
+        return max(minimum, learning_rate / 1.5)
+    if 0 < kl_mean < target / 2:
+        return min(maximum, learning_rate * 1.5)
+    return learning_rate
+
+
 def huber_loss(error: torch.Tensor, delta: float) -> torch.Tensor:
     return torch.where(
         error.abs() < delta, 0.5 * error**2, delta * (error.abs() - 0.5 * delta)
