+def _local_policy_rollout(policy, model_type):
+    """Exercise prediction without launching the worker's distributed runtime."""
+    from contextlib import nullcontext
+
+    from rlinf.config import SupportedModel
+    from rlinf.workers.rollout.hf.huggingface_worker import MultiStepRolloutWorker
+
+    SupportedModel.register(model_type, force=True)
+    worker = object.__new__(MultiStepRolloutWorker)
+    worker.model_cfg = SimpleNamespace(model_type=model_type)
+    worker.algorithm_cfg = {}
+    worker.hf_model = policy
+    worker.expert_model = None
+    worker.enable_dagger = False
+    worker._train_sampling_params = {"temperature": 0.8, "top_k": 7}
+    worker._eval_sampling_params = {"temperature": 0.0, "top_k": 2}
+    worker._accelerator_type = None
+    worker.worker_timer = lambda *args, **kwargs: nullcontext()
+    return worker
+
+
+def test_custom_policy_rollout_passes_mode_and_preserves_generation_options():
+    import torch
+
+    class GaussianPolicy:
+        def __init__(self):
+            self.calls = []
+
+        def predict_action_batch(self, env_obs, *, mode="train", **kwargs):
+            self.calls.append((mode, kwargs))
+            mean = env_obs["states"][:, None, :]
+            distribution = torch.distributions.Normal(mean, torch.ones_like(mean))
+            return (mean if mode == "eval" else distribution.sample()), {}
+
+    policy = GaussianPolicy()
+    worker = _local_policy_rollout(policy, "unit_test_custom_gaussian")
+    observation = {"states": torch.ones(4, 3)}
+    torch.manual_seed(42)
+    train, _ = worker.predict(observation, mode="train")
+    first, _ = worker.predict(observation, mode="eval")
+    second, _ = worker.predict(observation, mode="eval")
+    assert not torch.equal(train, first)
+    torch.testing.assert_close(first, observation["states"][:, None, :])
+    torch.testing.assert_close(second, first)
+    assert policy.calls == [
+        ("train", {"temperature": 0.8, "top_k": 7}),
+        ("eval", {"temperature": 0.0, "top_k": 2}),
+        ("eval", {"temperature": 0.0, "top_k": 2}),
+    ]
+    assert worker._train_sampling_params == {"temperature": 0.8, "top_k": 7}
+    assert worker._eval_sampling_params == {"temperature": 0.0, "top_k": 2}
+
+
+def test_generation_only_policy_rollout_does_not_receive_new_mode_argument():
+    import torch
+
+    class GenerationPolicy:
+        def __init__(self):
+            self.calls = []
+
+        def predict_action_batch(self, env_obs, **kwargs):
+            self.calls.append(kwargs)
+            return torch.zeros(1, 1, 2), {}
+
+    policy = GenerationPolicy()
+    worker = _local_policy_rollout(policy, "unit_test_generation_only")
+    worker.predict({}, mode="train")
+    worker.predict({}, mode="eval")
+    assert policy.calls == [
+        {"temperature": 0.8, "top_k": 7},
+        {"temperature": 0.0, "top_k": 2},
+    ]
+
+
+def test_builtin_policy_rollout_keeps_its_existing_mode_contract():
+    import torch
+
+    from rlinf.config import SupportedModel
+
+    class BuiltinPolicy:
+        def predict_action_batch(self, env_obs, **kwargs):
+            self.received = kwargs
+            return torch.zeros(1, 1, 2), {}
+
+    policy = BuiltinPolicy()
+    worker = _local_policy_rollout(policy, SupportedModel.MLP_POLICY.value)
+    worker.predict({}, mode="eval")
+    assert policy.received == {"mode": "eval", "return_obs": True}
